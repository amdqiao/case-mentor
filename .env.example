# CaseMentor configuration. Copy to .env, or let ./setup.sh write it for you.
# .env is gitignored — never commit it.

# ---------------------------------------------------------------- required
# Anthropic API key. Billing for every interview lands here.
# Get one at https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=

# Telegram bot token, from @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to use the bot.
# EMPTY MEANS NOBODY — the bot fails closed on purpose. Bot usernames are searchable,
# so an open bot lets a stranger run interviews on your API key.
# Find yours by messaging @userinfobot in Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------- optional: Notion
# Leave NOTION_TOKEN blank to disable the case log entirely. The debrief still arrives
# in Telegram; nothing is written anywhere.
#
# To enable: create an internal integration at https://www.notion.so/my-integrations,
# duplicate the Case Log database template, share it with your integration, then paste
# the ids below. The database must already have the properties the skill expects —
# note the en dashes in the three grade columns.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------- tuning
# Model used for the interview.
ANTHROPIC_MODEL=claude-sonnet-5

# Seconds to wait for a follow-up message before answering, so rapid-fire typing
# collapses into one turn instead of several.
DEBOUNCE_SECONDS=4

# Silence that ends the case, and the absolute session cap. Both close with partial
# grading rather than discarding the session.
INACTIVITY_TIMEOUT_MIN=10
HARD_STOP_MIN=50

# Largest single message the agent may return. Parsing a PDF sends every page as an
# image in one message, so a 595 KB / 17-page case is ~2.5 MB on the wire. The SDK
# default of 1 MB is too small for real casebooks.
AGENT_MAX_BUFFER_MB=32

# Largest case PDF accepted from Telegram. The Bot API refuses over 20 MB regardless.
MAX_PDF_MB=20
